# Contact form (existing)
GMAIL_USER=
GMAIL_PASS=

# Admin at /admin: résumé uploads. Use a long, unique password.
ADMIN_PASSWORD=
# Signs the admin session cookie. Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Contact-form inbox: Neon Postgres (added automatically when you connect a Neon database in Vercel)
DATABASE_URL=

# Vercel Blob storage for the résumé (added automatically when you connect a Blob store in Vercel)
BLOB_READ_WRITE_TOKEN=
